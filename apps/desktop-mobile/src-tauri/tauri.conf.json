{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨知",
  "version": "0.8.0-beta.2",
  "identifier": "app.mozhi.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "墨知",
        "width": 1280,
        "height": 840,
        "minWidth": 780,
        "minHeight": 580,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://github.com; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "本地优先的 Markdown 笔记"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5QzhCRTBDOEI2RkMxClJXVEJiNHNNdnNpWkFINHdaYjlLcnVRaGRDRUV6MnptQzhrUlNXMnBpZ2ZUaklNTWpXNDErY2Z3Cg==",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/yue19870813/mozhi/releases/latest/download/latest.json"
      ]
    }
  }
}
