{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨知",
  "version": "0.3.0",
  "identifier": "app.mozhi.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "墨知",
        "width": 1280,
        "height": 840,
        "minWidth": 780,
        "minHeight": 580,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "本地优先的 Markdown 笔记"
  }
}
